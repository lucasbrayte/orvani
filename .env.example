# Fonte do catálogo: "demo" para dados fictícios locais ou "supabase" para o catálogo sincronizado.
CATALOG_DATA_MODE=

# URL pública canônica do site. Em produção, use HTTPS.
NEXT_PUBLIC_SITE_URL=

# Supabase. A publishable key não é secreta, mas a aplicação a usa apenas no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Segredo server-only; nunca use prefixo NEXT_PUBLIC_ nem envie ao navegador.
SUPABASE_SECRET_KEY=

# Google Sheets privado. A faixa recomendada é produtos!A:S.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Aceita uma chave PEM com quebras de linha escapadas como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Segredo server-only com no mínimo 32 bytes para POST /api/internal/sync.
CATALOG_SYNC_SECRET=

# Hosts HTTPS de afiliados, separados por vírgula e sem protocolo/caminho.
AFFILIATE_ALLOWED_HOSTS=

# Hosts HTTPS das imagens editoriais, separados por vírgula e sem protocolo/caminho.
PRODUCT_IMAGE_ALLOWED_HOSTS=
